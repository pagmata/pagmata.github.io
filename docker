def upload_pdf():
    global client

    file = request.files.get("document")
    if not file:
        return jsonify({"error": "No file uploaded"}), 400

    filename = secure_filename(file.filename)
    if not filename.lower().endswith(".pdf"):
        return jsonify({"error": "Only PDF files allowed"}), 400

    file_content = file.read()
    if len(file_content) > MAX_PDF_SIZE:
        return jsonify({"error": "PDF exceeds max size"}), 413

    mime_type = magic.from_buffer(file_content[:2048], mime=True)
    if mime_type not in ALLOWED_MIMES:
        return jsonify({"error": "Invalid MIME type"}), 415

    sha256_hash    = hashlib.sha256(file_content).hexdigest()
    extracted_text = extract_text_from_pdf(file_content)
    extracted_text = redact_sensitive_data(extracted_text)
    classification = classify_document(extracted_text)
    metadata       = extract_metadata(extracted_text)

    tx = client.set(sha256_hash.encode(), b"VERIFIED_BY_ORP_ENGINE")

    local_tz     = pytz.timezone(TZ_NAME)
    timestamp_ph = datetime.datetime.now(local_tz).strftime("%Y-%m-%d %I:%M %p PHT")
    control_no   = next_control_number()
    final_ctrl   = f"Verified_{control_no}"

    record = {
        "status":                    "VERIFIED",
        "control_number":            final_ctrl,
        "document_type":             classification["document_type"],
        "classification_confidence": classification["confidence"],
        "metadata":                  metadata,
        "sha256_hash":               sha256_hash,
        "timestamp":                 timestamp_ph,
        "immudb_transaction_id":     tx.id,
        "verification_url":          f"{GITHUB_PORTAL}?hash={sha256_hash}"
    }

    signature = sign_json_data(record)
    if signature:
        record["data_signature"] = signature

    json_path = os.path.join(RECORDS_DIR, f"{final_ctrl}_{sha256_hash[:16]}.json")
    with open(json_path, "w") as f:
        json.dump(record, f, indent=4)

    qr_buf      = generate_qr(sha256_hash)
    stamped_pdf = add_footer(
        file_content, sha256_hash, qr_buf, timestamp_ph, final_ctrl
    )

    safe_doc_type   = re.sub(r'[^A-Za-z0-9_-]', '_', classification["document_type"])
    output_filename = f"{final_ctrl}_{safe_doc_type}_{sha256_hash[:12]}.pdf"

    logger.info("Processed: %s", output_filename)

    return send_file(
        stamped_pdf,
        as_attachment=True,
        download_name=output_filename,
        mimetype="application/pdf"
    )

