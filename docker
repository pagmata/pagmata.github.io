def extract_text_from_pdf(pdf_bytes: bytes) -> str:
    text = ""

    try:
        reader = PdfReader(io.BytesIO(pdf_bytes))
        for page in reader.pages:
            extracted = page.extract_text()
            if extracted:
                text += extracted + "\n"
    except Exception as e:
        logger.warning(f"PDF extraction failed: {e}")

    if len(text.strip()) < 50:
        try:
            logger.info("Running OCR fallback")
            images   = convert_from_bytes(pdf_bytes, dpi=300)
            ocr_text = ""
            for img in images:
                ocr_text += pytesseract.image_to_string(img)
            text += "\n" + ocr_text
        except Exception as e:
            logger.error(f"OCR failed: {e}")

    return text.strip()

# =============================================================================
# DOCUMENT CLASSIFIER
# =============================================================================


DOCUMENT_TYPES = {
    "Barangay Clearance": [
        "barangay clearance", "good moral", "resident", "clearance"
    ],
    "Certificate of Indigency": [
        "indigent", "certificate of indigency", "financial assistance"
    ],
    "Business Permit": [
        "business permit", "mayor's permit", "business clearance"
    ],
    "Blotter Report": [
        "blotter", "incident", "complainant", "respondent"
    ],
    "Residency Certificate": [
        "resident of", "residing at", "certificate of residency"
    ]
}


def classify_document(text: str):
    text_lower       = text.lower()
    best_match       = "Unknown"
    best_score       = 0
    matched_keywords = []

    for doc_type, keywords in DOCUMENT_TYPES.items():
        score = 0
        found = []
        for keyword in keywords:
            if keyword in text_lower:
                score += 1
                found.append(keyword)
        if score > best_score:
            best_score       = score
            best_match       = doc_type
            matched_keywords = found

    confidence = 0.0
    if best_score > 0:
        confidence = round(
            (best_score / max(len(DOCUMENT_TYPES[best_match]), 1)) * 100, 2
        )

    return {
        "document_type":    best_match,
        "confidence":       confidence,
        "matched_keywords": matched_keywords
    }

# =============================================================================
# PRIVACY-AWARE METADATA EXTRACTION
# =============================================================================


def redact_sensitive_data(text: str) -> str:
    text = re.sub(r'(\+63\d{10}|09\d{9})', '[REDACTED_PHONE]', text)
    text = re.sub(r'[\w\.-]+@[\w\.-]+',    '[REDACTED_EMAIL]', text)
    return text


def extract_metadata(text: str):
    metadata = {"document_reference": None, "document_date": None}

    control_match = re.search(r'\b\d{4}-\d{4}\b', text)
    if control_match:
        metadata["document_reference"] = control_match.group(0)

    date_match = re.search(
        r'\b(?:January|February|March|April|May|June|July|August|'
        r'September|October|November|December)\s+\d{1,2},\s+\d{4}',
        text, re.IGNORECASE
    )
    if date_match:
        metadata["document_date"] = date_match.group(0)

    return metadata

