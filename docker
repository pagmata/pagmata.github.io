def next_control_number():
    with ctrl_lock:
        local_tz     = pytz.timezone(TZ_NAME)
        current_year = str(datetime.datetime.now(local_tz).year)

        if not os.path.exists(CONTROL_FILE):
            fd = os.open(CONTROL_FILE, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o600)
            os.write(fd, b"2026-0000")
            os.close(fd)

        with open(CONTROL_FILE, "r+") as f:
            fcntl.flock(f, fcntl.LOCK_EX)
            try:
                year, num = f.read().strip().split("-")
                num = int(num)
                if year != current_year:
                    year = current_year
                    num  = 0
                new_ctrl = f"{year}-{num + 1:04d}"
                f.seek(0)
                f.write(new_ctrl)
                f.truncate()
            finally:
                fcntl.flock(f, fcntl.LOCK_UN)

        return new_ctrl

# =============================================================================
# QR
# =============================================================================


def generate_qr(sha256_hash):
    qr_url = f"{GITHUB_PORTAL}?hash={sha256_hash}"
    qr = qrcode.QRCode(version=1, box_size=10, border=4)
    qr.add_data(qr_url)
    img = qr.make_image()
    buf = io.BytesIO()
    img.save(buf, format="PNG")
    buf.seek(0)
    return buf

# =============================================================================
# PDF STAMP
# =============================================================================


def add_footer(original_pdf, sha256_hash, qr_buf, timestamp, control_number):
    reader   = PdfReader(io.BytesIO(original_pdf))
    writer   = PdfWriter()
    qr_image = ImageReader(qr_buf)

    for page in reader.pages:
        packet = io.BytesIO()
        c = canvas.Canvas(packet, pagesize=A4)
        c.line(25 * mm, 22 * mm, 185 * mm, 22 * mm)
        c.setFont("Helvetica", 7)
        c.drawString(30 * mm, 18 * mm, f"CTRL: {control_number}")
        c.drawString(30 * mm, 14 * mm, f"TIME: {timestamp}")
        c.drawString(30 * mm, 10 * mm, f"HASH: {sha256_hash[:24]}...")
        c.drawImage(qr_image, 165 * mm, 5 * mm, width=15 * mm, height=15 * mm)
        c.save()
        packet.seek(0)
        overlay = PdfReader(packet)
        page.merge_page(overlay.pages[0])
        writer.add_page(page)

    output = io.BytesIO()
    writer.write(output)
    output.seek(0)
    return output

