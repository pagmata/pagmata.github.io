def get_client():
    global _vault_password

    if ":" in IMMUDB_HOST:
        host, port = IMMUDB_HOST.rsplit(":", 1)
        port = int(port)
    else:
        host, port = IMMUDB_HOST, 3322

    # ── CHANGE 1 ─────────────────────────────────────────────────────────────
    # getpass.getpass() removed — blocks forever without a TTY.
    # Password read from Docker secret mounted as tmpfs at
    # /run/secrets/immudb_password (chmod 400, never in env vars,
    # never in docker inspect, gone when container stops).
    # ─────────────────────────────────────────────────────────────────────────
    if _vault_password is None:
        _secret = "/run/secrets/immudb_password"
        try:
            with open(_secret) as f:
                _vault_password = f.read().strip()
        except FileNotFoundError:
            raise RuntimeError(
                f"Docker secret not found at {_secret}. "
                "Ensure immudb_password is declared in compose secrets block "
                "and ./secrets/immudb_password.txt exists on the host."
            )

    client = ImmudbClient(f"{host}:{port}")
    client.login(IMMUDB_USER, _vault_password, database=IMMUDB_DB)

    logger.info("Vault connected")
    return client


# ── CHANGE 3 ─────────────────────────────────────────────────────────────────
# Module-level client = get_client() wrapped with retry logic.
#
# depends_on: service_healthy confirms immudb's TCP port is open.
# It does NOT confirm immudb has finished internal initialisation
# (WAL replay, index loading). Without retry, a fast Python startup
# crashes immediately and enters a restart loop that can corrupt
# immudb's write-ahead log.
#
# 5 attempts × 3s delay = 15s window — covers typical cold-start period.
# ─────────────────────────────────────────────────────────────────────────────
def _connect_with_retry(retries: int = 5, delay: int = 3):
    for attempt in range(1, retries + 1):
        try:
            return get_client()
        except Exception as e:
            logger.warning(
                "immudb connection attempt %d/%d failed: %s",
                attempt, retries, e
            )
            if attempt < retries:
                time.sleep(delay)
    raise RuntimeError(
        "immudb unreachable after all retries. "
        "Check immudb container health and backend_net connectivity."
    )


client = _connect_with_retry()

