done
for f in $(find /pki -name "*.p12"); do
    [ "$(stat -c %a $f)" = "600" ] || FAIL=1
done

[ "$FAIL" -eq 0 ] || die "Permissions audit failed!"
ok "Audit passed. PKI Initialised."
