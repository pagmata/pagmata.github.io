FROM alpine:3.21
ENV PKI_DIR=/pki \
    FLASK_PORT=8000

RUN apk add --no-cache \
    nginx \
    gettext

RUN addgroup -S nginxgrp && \
    adduser -S -D -H \
    -h /nonexistent \
    -s /sbin/nologin \
    -G nginxgrp \
    nginxusr

RUN addgroup -g 8000 pkireaders && adduser nginxusr pkireaders

RUN mkdir -p \
    /run/nginx \
    /var/cache/nginx \
    /etc/nginx/conf.d \
    /tmp/nginx_client_temp && \
    chown -R nginxusr:nginxgrp \
    /run/nginx \
    /var/cache/nginx \
    /etc/nginx \
    /tmp/nginx_client_temp

COPY nginx.conf /etc/nginx/nginx.conf

COPY orp_engine.conf.tpl /etc/nginx/templates/orp_engine.conf.tpl

COPY entrypoint.sh /entrypoint.sh

RUN chmod 755 /entrypoint.sh

USER nginxusr

EXPOSE 9443

ENTRYPOINT ["/entrypoint.sh"]

CMD ["nginx", "-g", "daemon off;"]
#!/bin/sh
set -eu

TEMPLATE="/etc/nginx/templates/orp_engine.conf.tpl"
OUTPUT="/etc/nginx/conf.d/orp_engine.conf"

echo "[*] Validating PKI assets..."

for cert in \
    "$PKI_DIR/nginx/nginx.crt" \
    "$PKI_DIR/nginx/nginx.key" \
    "$PKI_DIR/ca/ca.crt"
do
    if [ ! -f "$cert" ]; then
        echo "[ERROR] Missing certificate: $cert"
        exit 1
    fi
done

echo "[*] Rendering nginx template..."

envsubst '${PKI_DIR} ${FLASK_PORT}' \
    < "$TEMPLATE" \
    > "$OUTPUT"

echo "[*] Testing nginx configuration..."

nginx -t

echo "[*] Starting nginx..."

exec "$@"
worker_processes auto;

pid /run/nginx/nginx.pid;

events {
    worker_connections 1024;
    use epoll;
    multi_accept on;
}

http {
    include      /etc/nginx/mime.types;
    default_type application/octet-stream;

    server_tokens off;

    sendfile    on;
    tcp_nopush  on;
    tcp_nodelay on;

    keepalive_timeout 65;

    client_body_temp_path /tmp/nginx_client_temp;

    log_format main '$remote_addr - $remote_user [$time_local] '
                    '"$request" $status $body_bytes_sent '
                    '"$http_referer" "$http_user_agent" '
                    'ssl_verify=$ssl_client_verify '
                    'operator="$ssl_client_s_dn"';

    access_log /dev/stdout main;
    error_log  /dev/stderr warn;

    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;
    include /etc/nginx/conf.d/*.conf;
}
server {
    listen      9443 ssl http2;
    server_name _;

    server_tokens off;

    ssl_certificate     ${PKI_DIR}/nginx/nginx.crt;
    ssl_certificate_key ${PKI_DIR}/nginx/nginx.key;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;
    ssl_ciphers "ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:TLS_AES_128_GCM_SHA256:TLS_AES_256_GCM_SHA384";

    ssl_session_timeout 1d;
    ssl_session_tickets off;

    ssl_stapling        off;
    ssl_stapling_verify off;

    ssl_client_certificate ${PKI_DIR}/ca/ca.crt;
    ssl_verify_client      on;
    ssl_verify_depth       1;

    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;

    add_header X-Frame-Options "DENY" always;

    add_header X-Content-Type-Options "nosniff" always;

    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    add_header Content-Security-Policy "default-src 'self'; frame-ancestors 'none';" always;

    add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;

    client_max_body_size   20M;
    client_body_timeout    15s;
    client_header_timeout  15s;
    keepalive_timeout      30s;
    send_timeout           15s;

    location / {

        proxy_pass http://orp-engine:${FLASK_PORT};
        proxy_http_version 1.1;
        proxy_set_header   Connection "";
        proxy_set_header X-Operator-ID       $ssl_client_s_dn;
        proxy_set_header X-SSL-Client-Verify $ssl_client_verify;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;
        proxy_set_header X-Forwarded-Port  $server_port;
        proxy_connect_timeout 10s;
        proxy_send_timeout    30s;
        proxy_read_timeout    120s;
        proxy_buffering    on;
        proxy_buffers      16 16k;
        proxy_buffer_size  16k;
        proxy_hide_header  X-Powered-By;
        proxy_hide_header  Server;
    }

    location = /health {
