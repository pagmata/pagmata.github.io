GPG_HOME      = os.getenv("GNUPGHOME")
GPG_EMAIL     = os.getenv("OPERATOR_GPG_EMAIL")
SSH_AUTH_SOCK = os.getenv("SSH_AUTH_SOCK")

# ── CHANGE 2 ─────────────────────────────────────────────────────────────────
# ORP_CONTAINER_MODE=1 is set in docker-compose.yml environment block.
# In container mode, SSH_AUTH_SOCK is not checked — the SSH agent lives on
# the host and is not forwarded into the container. Git push operations
# are handled outside the container boundary (separate CI/CD concern).
# When running locally via the ORP bootloader, CONTAINER_MODE=0 (default)
