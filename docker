CONTAINER_MODE = os.getenv("ORP_CONTAINER_MODE", "0") == "1"

if CONTAINER_MODE:
    if not all([GPG_HOME, GPG_EMAIL]):
        raise RuntimeError(
            "GNUPGHOME and OPERATOR_GPG_EMAIL are required in container mode. "
            "Set them in docker-compose.yml environment block."
        )
